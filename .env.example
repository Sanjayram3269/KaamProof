# Local Docker: use a unique URL-safe random password (letters and digits).
POSTGRES_PASSWORD=replace-with-a-random-local-password
APP_ORIGIN=http://localhost:8080
ENVIRONMENT=development
# Local Python only: SQLite is the default. Production requires PostgreSQL + HTTPS.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/kaamproof
# DATA_DIR=./data
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=KaamProof <records@example.com>
# S3_BUCKET=private-evidence
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Optional: actual public HTTPS origin for canonical URLs, sitemap and indexing.
# Keep unset for local/private installations.
# SITE_URL=https://your-public-domain.example
